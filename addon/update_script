#!/bin/sh
#
#   update_script of lite-addon-forwarder (MIT): the CCU addon handbook's steps (chapter 02), for
#   openccu-lite only. The system unpacks the archive below /usr/local/tmp, cd's into it and runs
#   ./update_script. Exit 10 = fresh install, 0 = update. The manifest openccu-lite.json beside
#   this script is read by the system before this script runs; the unit, the proxy rule and the
#   menu entry are the system's.
#
#   The addon's tree is forwarder/ next to this script: bin/forwarder (the daemon), app/ (the
#   configuration page, served by the daemon at /addons/forwarder/), www/ (the icons and the 503
#   page), rc.d (the service script), etc/lighttpd.conf (the proxy rule).
#
#   The data stays: etc/ (the targets, selections and secrets) and var/ are never touched by an
#   update, and an uninstall leaves them for a reinstall as well.
#

ADDON=forwarder
ADDONS_DIR=/usr/local/addons
ADDON_DIR=$ADDONS_DIR/$ADDON
CONF_DIR=/usr/local/etc/config
WWW_DIR=$CONF_DIR/addons/www/$ADDON
EXITCODE=10

mount | grep /usr/local >/dev/null 2>&1 || mount /usr/local

mkdir -p $ADDONS_DIR && chmod 755 $ADDONS_DIR
mkdir -p $CONF_DIR/addons/www && chmod 755 $CONF_DIR/addons/www
mkdir -p $CONF_DIR/rc.d

# an update: stop the running service through the previous version's script
if [ -f $CONF_DIR/rc.d/$ADDON ]; then
    EXITCODE=0
    $CONF_DIR/rc.d/$ADDON stop
fi

# everything but etc/ and var/ is the program's: nothing stale may survive an update
rm -rf "${ADDON_DIR:?}/bin" "${ADDON_DIR:?}/app" "${ADDON_DIR:?}/www" "${ADDON_DIR:?}/rc.d" "${ADDON_DIR:?}/versions"
rm -f "${ADDON_DIR:?}/etc/lighttpd.conf"

mkdir -p $ADDON_DIR
cp -af $ADDON/bin $ADDON/app $ADDON/www $ADDON/rc.d $ADDON/versions $ADDON_DIR/
mkdir -p $ADDON_DIR/etc $ADDON_DIR/var
cp -af $ADDON/etc/lighttpd.conf $ADDON_DIR/etc/
chmod 755 $ADDON_DIR/bin/$ADDON $ADDON_DIR/rc.d

# the program directories are not worth a backup; the data in etc/ and var/ is
touch $ADDON_DIR/bin/.nobackup $ADDON_DIR/app/.nobackup $ADDON_DIR/www/.nobackup

# links: -n because busybox ln -T refuses to replace an existing directory symlink. /addons/forwarder/
# is proxied to the daemon before any file could be served from the link; the link keeps the tree
# behind it world-readable (the 503 page), as the system closes the addon's other files.
rmdir $WWW_DIR 2>/dev/null
ln -sfn $ADDON_DIR/www $WWW_DIR
ln -sf $ADDON_DIR/rc.d $CONF_DIR/rc.d/$ADDON

sync

# openccu-lite starts the unit itself after a fresh install; after an update it is started here
if [ $EXITCODE -eq 0 ]; then
    systemctl start addon-$ADDON.service 2>/dev/null || true
fi

exit $EXITCODE
