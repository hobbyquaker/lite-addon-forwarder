/dist/
/ui/node_modules/
/ui/dist/
# the build fills app/ and bin/; the manifest's icons are tracked in www/, where the catalogue
# reads them beside the manifest at the release tag
/addon/forwarder/app/
/addon/forwarder/bin/
/addon/forwarder/versions
# etc/ holds the tracked proxy rule (lighttpd.conf, packaged) and, on a system, the configuration and the secrets
/addon/forwarder/etc/forwarder.json
/addon/forwarder/etc/secrets.json
/addon/forwarder/etc/*.tmp
/addon/forwarder/var/
/ui/test-results/
/ui/playwright-report/
